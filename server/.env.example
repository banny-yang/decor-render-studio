# 复制为 .env 并按需修改

# ComfyUI 服务地址（GPU 服务器）
COMFYUI_URL=http://127.0.0.1:8188

# 无 GPU/ComfyUI 时置 true，用模拟模式联调整套系统
MOCK_COMFYUI=false

# 主模型文件名（需与 ComfyUI/models/checkpoints/ 下一致）
CHECKPOINT_NAME=realvisxlV50_v50LightningBakedvae.safetensors

# 登录令牌签名密钥，生产环境务必修改
SECRET_KEY=please-change-me

# 数据库（起步 SQLite，可切 postgresql://user:pass@host/db）
DATABASE_URL=sqlite:///./realvisxl.db
